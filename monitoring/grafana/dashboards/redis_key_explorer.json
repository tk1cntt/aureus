    {
      "datasource": {
        "type": "redis-datasource",
        "uid": "redis-dev"
      },
      "description": "Auto-detect type (string/hash/list/set/zset) và pretty-print value.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "displayMode": "auto"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "id": 19,
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "query": "eval \"local k=KEYS[1]; local lim=tonumber(ARGV[1]) or 50; local t=redis.call('TYPE',k)['ok']; local function q(v) if v==false or v==nil then return 'null' end; v=tostring(v); v=string.gsub(v,'\\\\','\\\\\\\\'); v=string.gsub(v,'\"','\\\\\"'); return '\"'..v..'\"' end; if t=='none' then return '{\\n  \\\"type\\\": \\\"none\\\",\\n  \\\"value\\\": null\\n}' end; if t=='string' then local v=redis.call('GET',k); return '{\\n  \\\"type\\\": \\\"string\\\",\\n  \\\"value\\\": '..q(v)..'\\n}' end; if t=='hash' then local a=redis.call('HGETALL',k); local c=math.min(#a,lim*2); local out='{\\n  \\\"type\\\": \\\"hash\\\",\\n  \\\"value\\\": {'; for i=1,c,2 do local s=(i<c-1) and ',' or ''; out=out..'\\n    '..q(a[i])..': '..q(a[i+1])..s; end; return out..'\\n  }\\n}' end; if t=='list' then local a=redis.call('LRANGE',k,0,lim); local out='{\\n  \\\"type\\\": \\\"list\\\",\\n  \\\"value\\\": ['; for i=1,#a do local s=(i<#a) and ',' or ''; out=out..'\\n    '..q(a[i])..s; end; return out..'\\n  ]\\n}' end; if t=='set' then local a=redis.call('SMEMBERS',k); local n=math.min(#a,lim); local out='{\\n  \\\"type\\\": \\\"set\\\",\\n  \\\"value\\\": ['; for i=1,n do local s=(i<n) and ',' or ''; out=out..'\\n    '..q(a[i])..s; end; return out..'\\n  ]\\n}' end; if t=='zset' then local a=redis.call('ZRANGE',k,0,lim,'WITHSCORES'); local out='{\\n  \\\"type\\\": \\\"zset\\\",\\n  \\\"value\\\": ['; for i=1,#a,2 do local s=(i<#a-1) and ',' or ''; out=out..'\\n    {\\\"member\\\": '..q(a[i])..', \\\"score\\\": '..q(a[i+1])..'}'..s; end; return out..'\\n  ]\\n}' end; return '{\\n  \\\"type\\\": '..q(t)..',\\n  \\\"note\\\": \\\"unsupported\\\"\\n}'\" 1 ${selected_key} ${sample_limit}",
          "refId": "A",
          "type": "cli"
        }
      ],
      "title": "Value Preview (Auto by Type)",
      "type": "table"
    }

# ==========================================
# Aureus — Environment Variables
# ==========================================

# Database
DB_PASSWORD=aureus_password

# Redis
DEV_REDIS_PORT=6380

# Gateway
DEV_BACKTEST_WS_PORT=5555
DEV_BACKTEST_EVENTS_PORT=5556

# Database
DEV_DB_PORT=5433

# API / Dashboard
DEV_API_PORT=8002
DEV_WEB_PORT=17222

# Monitoring
DEV_BRIDGE_METRICS_PORT=19158
DEV_PROMETHEUS_PORT=19590
DEV_GRAFANA_PORT=13555

# Nautilus
NAUTILUS_SYMBOL_WHITELIST=XAUUSD
NAUTILUS_RISK_MODE=STRICT
NAUTILUS_REQUIRE_SL_TP=1
NAUTILUS_MAX_ORDER_NOTIONAL=10000
NAUTILUS_MAX_POSITION_NOTIONAL=100000
NAUTILUS_ADAPTER_MODE=simulated

# Symbols (comma-separated, used by signal and notifier services)
SYMBOLS=XAUUSD,BTCUSD,ETHUSD,USTEC,USDJPY,EURUSD,GBPUSD,AUDUSD

# Telegram Notifier (Phase 27)
TELEGRAM_BOT_TOKEN=          # Bot token from @BotFather on Telegram
TELEGRAM_DEFAULT_CHAT_ID=    # Chat/channel ID (use @userinfobot to get your ID)

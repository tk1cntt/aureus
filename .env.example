# === AUREUS TRADING SYSTEM - ENVIRONMENT CONFIGURATION ===
# Copy this file to .env and update with your actual values
# NEVER commit .env to version control!

# ==========================================
# DATABASE & REDIS
# ==========================================

# Redis Configuration
REDIS_PORT=6379
DEV_REDIS_PORT=6380

# PostgreSQL/TimescaleDB Configuration
DB_PORT=5432
DEV_DB_PORT=5433
DB_PASSWORD=aureus_password

# ==========================================
# TRADING SYMBOLS
# ==========================================

# Comma-separated list of symbols to trade
# Supported: XAUUSD, BTCUSD, ETHUSD, USTEC, USDJPY, EURUSD, GBPUSD, AUDUSD
SYMBOLS=XAUUSD,BTCUSD,ETHUSD,USTEC,USDJPY,EURUSD,GBPUSD,AUDUSD

# ==========================================
# EXECUTION SETTINGS
# ==========================================

# Default order size for signals
SIGNAL_ORDER_SIZE=0.01

# Execution mode: simulated | nautilus
# EXECUTION_MODE=simulated
# NAUTILUS_ADAPTER_MODE=stream

# ==========================================
# SERVICE PORTS (Production)
# ==========================================

WEB_PORT=12321
API_PORT=8001
BACKTEST_WS_PORT=5555
BACKTEST_EVENTS_PORT=5556
BRIDGE_METRICS_PORT=19158
PROMETHEUS_PORT=19590

# ==========================================
# SERVICE PORTS (Development)
# ==========================================

DEV_WEB_PORT=17222
DEV_API_PORT=8002
DEV_BACKTEST_WS_PORT=5555
DEV_BACKTEST_EVENTS_PORT=5556
DEV_BRIDGE_METRICS_PORT=19158
DEV_PROMETHEUS_PORT=19590
DEV_GRAFANA_PORT=13555

# ==========================================
# TELEGRAM - TRADING NOTIFICATIONS
# ==========================================

# Signal Bot Token (from @BotFather on Telegram)
TELEGRAM_SIGNAL_BOT_TOKEN=your_signal_bot_token_here

# Default Chat/Channel ID (use @userinfobot to get your ID)
TELEGRAM_DEFAULT_CHAT_ID=your_chat_id_here

# Strategy Bot Token
TELEGRAM_STRATEGY_BOT_TOKEN=your_strategy_bot_token_here

# Order Bot Token
TELEGRAM_ORDER_BOT_TOKEN=your_order_bot_token_here

# ==========================================
# TELEGRAM - CODING ASSISTANT
# ==========================================

# Main Bot Token for coding assistant
TELEGRAM_BOT_TOKEN=your_coding_bot_token_here
TELEGRAM_CHAT_ID=your_coding_chat_id_here

# Bot username (without @)
TELEGRAM_BOT_USERNAME=your_bot_username

# Relay mode: monorepo | standalone
RELAY_MODE=monorepo

# CLI to use: openclaude | claude
MONOREPO_CLI=openclaude

# Max conversation turns
MAX_TURNS=20

# Permission mode: auto | manual
OPENCLAUDE_PERMISSION_MODE=auto

# ==========================================
# AI/LLM CONFIGURATION
# ==========================================

# OpenAI-compatible API endpoint (for local models)
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=qw/coder-model

# Anthropic API settings
USE_SDK=true
ANTHROPIC_BASE_URL=http://localhost:20128/v1
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model aliases
ANTHROPIC_DEFAULT_OPUS_MODEL=qw/coder-model
ANTHROPIC_DEFAULT_SONNET_MODEL=qw/coder-model
ANTHROPIC_DEFAULT_HAIKU_MODEL=qw/coder-model

# ==========================================
# CLAUDE CLI SETTINGS
# ==========================================

# Path to Claude CLI executable
CLAUDE_CLI_PATH=

# Max conversation turns
CLAUDE_MAX_TURNS=100

# Timeout in seconds (2 hours default)
CLAUDE_TIMEOUT_SECONDS=7200

# Budget limits (0 = unlimited)
CLAUDE_MAX_COST_PER_USER=0
CLAUDE_MAX_COST_PER_REQUEST=0
CLAUDE_DISABLE_BUDGET=true

# Parallel agent execution
EXECUTE_PARALLEL_AGENTS=false

# ==========================================
# SIGNAL ENGINE CONFIGURATION
# ==========================================

# Trading timeframe: M1 | M5 | M15 | M30 | H1 | H4 | D1
# Affects auto-calculated timeouts and history sizing
SIGNAL_TIMEFRAME=M1

# Strategy trigger timeout (candles)
# How many candles to wait before clearing triggered_t to prevent post-trigger stalls
# Default: auto-calculated from SIGNAL_TIMEFRAME (2 hours worth of candles)
# Examples:
#   M1:  120 candles = 2 hours
#   M5:  24 candles  = 2 hours
#   M15: 8 candles   = 2 hours
#   H1:  2 candles   = 2 hours
#   H4:  1 candle    = 4 hours
# Leave empty to auto-calculate based on SIGNAL_TIMEFRAME
STRATEGY_TRIGGER_TIMEOUT_CANDLES=

# Signal history max size (records before truncation)
# Number of normalized signal records to keep in memory
# Higher = more context for strategy matching, more memory usage
# Default: 200 records
#   M1:  ~200 minutes  = ~3.3 hours
#   M15: ~200 candles  = ~50 hours
#   H1:  ~200 candles  = ~200 hours
SIGNAL_HISTORY_MAX_SIZE=200

# Auto-reset max wait candles
# Max candles to wait for mid-sequence matching before auto-resetting
# Prevents strategies from getting stuck waiting for a signal that may never come
# Default: 50 candles
AUTO_RESET_MAX_WAIT_CANDLES=50

# ==========================================
# SECURITY SETTINGS
# ==========================================

# Approved directory for file operations
APPROVED_DIRECTORY=D:\Aureus

# Allowed user IDs (comma-separated)
ALLOWED_USERS=your_user_id_here

# Allowed group users (comma-separated)
ALLOWED_GROUP_USERS=your_group_user_ids_here

# Token authentication
ENABLE_TOKEN_AUTH=false
AUTH_TOKEN_SECRET=

# Security validation (for development)
DISABLE_SECURITY_PATTERNS=false
DISABLE_TOOL_VALIDATION=false

# Safe mode: restricts dangerous operations
SAFE_MODE=true

# ==========================================
# NOTES
# ==========================================

# 1. Get Telegram Bot Token: Message @BotFather on Telegram, use /newbot
# 2. Get Chat ID: Message @userinfobot on Telegram
# 3. For local LLM: Set OPENAI_BASE_URL to your local server
# 4. For production: Change all passwords and API keys
# 5. TIMEFRAME affects all auto-calculated timeouts
# 6. Restart services after changing .env:
#    docker restart aureus-signal-dev aureus-strategy-executor-dev
